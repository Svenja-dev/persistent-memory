# Explicit endpoint of YOUR instance; HTTPS required except localhost/loopback.
MEMORY_API_URL=https://your-project-ref.supabase.co/functions/v1/memory-manager

# Read-only backup key configured on the server. Do not commit backup/.env.
API_SECRET_BACKUP=replace-with-your-backup-secret
# No generic API_SECRET or personal-file fallback is used.

# Separate restore-only key; set only when a restore is needed.
# API_SECRET_RESTORE=replace-with-your-restore-secret
