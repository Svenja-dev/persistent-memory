# Expliziter Endpunkt DEINER Instanz; HTTPS ist Pflicht, HTTP nur fuer localhost/Loopback.
MEMORY_API_URL=https://your-project-ref.supabase.co/functions/v1/memory-manager

# Serverseitig konfigurierter Nur-Lese-Schluessel fuer Backups. backup/.env niemals committen.
API_SECRET_BACKUP=replace-with-your-backup-secret
# Es gibt keinen Rueckfall auf ein generisches API_SECRET oder private Dateien.

# Separater Schluessel nur fuer Restore; nur setzen, wenn ein Restore ansteht.
# API_SECRET_RESTORE=replace-with-your-restore-secret
